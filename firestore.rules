rules_version = '2';
// Ajukas: Firestore'i turvareeglid.
// Kopeeri see Firebase konsoolis: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Teavitaja konto (GitHub Actions): võib soovitusi ainult lugeda ja märkida teavitatuks.
    function isBot() {
      return request.auth != null
        && request.auth.token.email == 'teavitaja@kasutaja.ajukas.app';
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nextonu@kasutaja.ajukas.app';
    }

    // Soovitused: igaüks võib saata; lugeda, märkida ja kustutada saab ainult admin.
    match /soovitused/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nimi', 'tekst', 'aeg', 'uid', 'failid'])
        && (!('failid' in request.resource.data)
            || (request.resource.data.failid is list && request.resource.data.failid.size() <= 3))
        && request.resource.data.tekst is string
        && request.resource.data.tekst.size() > 0
        && request.resource.data.tekst.size() <= 2000
        && request.resource.data.nimi is string
        && request.resource.data.nimi.size() <= 60
        && request.resource.data.aeg == request.time
        && request.resource.data.uid is string
        && (request.resource.data.uid == ''
            || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || isBot();
      allow delete: if isAdmin();
      // Admin võib muuta ainult olekut (uus / vaadatud / tehtud) ja prügikasti aega.
      // Manused: luuakse ainult koos soovitusega samas partiis; lugeda ja kustutada saab ainult admin.
      match /manused/{n} {
        allow create: if n in ['0', '1', '2']
          && request.resource.data.keys().hasOnly(['nimi', 'tyyp', 'andmed'])
          && request.resource.data.nimi is string && request.resource.data.nimi.size() <= 100
          && request.resource.data.tyyp is string && request.resource.data.tyyp.size() <= 100
          && request.resource.data.andmed is string && request.resource.data.andmed.size() < 1000000
          && !exists(/databases/$(database)/documents/soovitused/$(id))
          && getAfter(/databases/$(database)/documents/soovitused/$(id)).data.aeg == request.time;
        allow read, delete: if isAdmin();
      }

      allow update: if (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['olek', 'kustutatud'])
        && (!('olek' in request.resource.data)
            || request.resource.data.olek in ['uus', 'vaadatud', 'tehtud'])
        && (!('kustutatud' in request.resource.data)
            || request.resource.data.kustutatud == null
            || request.resource.data.kustutatud == request.time))
        || (isBot()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teavitatud'])
            && request.resource.data.teavitatud == true);
    }

    // Kohalolu: iga avatud leht kirjutab juhusliku id alla ainult serveri kellaaja.
    // Lugeda (loendada) ja vanu kirjeid kustutada saab ainult admin.
    match /kohal/{id} {
      allow create, update: if id.matches('^[0-9a-f]{20}$')
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
      allow read, delete: if isAdmin();
    }

    // Iga kasutaja näeb ja muudab ainult enda edusamme.
    match /kasutajad/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
